// ============================================================================
// AxeCompta Enterprise Edition — Schéma Prisma
// SaaS multi-tenant de comptabilité générale, analytique et fiscale
// (SYSCOHADA révisé) pour PME et cabinets comptables en Afrique.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANT
// ============================================================================

// Une Organization = une entreprise / un cabinet comptable (isolation par
// tenant). Toutes les entités métier portent un organizationId indexé pour
// garantir l'étanchéité des données entre organisations sur un schéma partagé.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String?
  city      String?
  country   String   @default("CM")
  phone     String?
  email     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personnalisation (logo/couleur affichés dans la sidebar et injectés en
  // variable CSS — voir app/(dashboard)/layout.tsx).
  logoUrl      String?
  primaryColor String?

  // Scaffold commercial SaaS: pas de facturation réelle branchée pour
  // l'instant (voir README), juste la sélection/affichage d'une offre.
  plan        OrgPlan   @default(STARTER)
  trialEndsAt DateTime?

  // Posé à la fin de l'assistant d'onboarding (/onboarding) — tant que null,
  // l'ADMIN de l'organisation est redirigé vers l'assistant à la connexion.
  onboardingCompletedAt DateTime?

  // Diagnostic produit par le copilote IA pendant l'étape d'audit de
  // l'onboarding (voir services/business-audit.service.ts): secteur, taille,
  // maturité comptable, risques et modules recommandés — utilisé pour
  // personnaliser le tableau de bord. auditCompletedAt reste null tant que
  // l'étape n'a pas été exécutée (ex: utilisateur qui a sauté l'étape).
  businessProfile   Json?
  auditCompletedAt  DateTime?

  // Rattachement optionnel à un groupe (holding, cabinet gérant plusieurs
  // dossiers clients) — utile pour une consolidation inter-entités future,
  // sans donner à qui que ce soit un accès direct aux données d'un autre tenant.
  groupId String?
  groupe  OrganizationGroup? @relation(fields: [groupId], references: [id])

  users     User[]
  auditLogs AuditLog[]

  accounts         Account[]
  journals         Journal[]
  journalEntries   JournalEntry[]
  thirdParties     ThirdParty[]
  costCenters      CostCenter[]
  assets           Asset[]
  scannedDocuments ScannedDocument[]
  aiConversations  AiConversation[]
  bankStatements   BankStatement[]

  @@index([slug])
}

model OrganizationGroup {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  organizations Organization[]
}

// ============================================================================
// AUTHENTIFICATION & RBAC
// ============================================================================

enum Role {
  ADMIN
  COMPTABLE
  CAISSIER
}

// Offre commerciale de l'organisation — voir lib/plans.ts pour les libellés
// et limites indicatives. Pas d'intégration de paiement réelle pour l'instant.
enum OrgPlan {
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email        String @unique
  passwordHash String // Argon2id
  firstName    String
  lastName     String
  phone        String?
  role         Role

  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  refreshToken String? // dernier refresh token émis (rotation)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Authentification à deux facteurs (TOTP, RFC 6238). totpSecret est posé
  // dès le lancement de l'activation mais totpEnabled ne passe à true
  // qu'après vérification d'un premier code — évite de verrouiller un
  // compte sur un secret jamais confirmé côté application cliente.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([]) // codes de récupération, hashés Argon2id

  // Verrouillage anti brute-force: compteur remis à zéro à chaque connexion
  // réussie, incrémenté à chaque mot de passe erroné. lockedUntil bloque la
  // connexion (même avec le bon mot de passe) jusqu'à son expiration.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Un compte super-admin opère au niveau plateforme (voir /api/superadmin),
  // en plus de son rôle métier normal dans son organisation — jamais un rôle
  // à part, pour ne pas complexifier la matrice RBAC existante.
  isSuperAdmin Boolean @default(false)

  // Compte technique créé à la demande pour le mode assistance super-admin
  // (voir services/superadmin.service.ts::getOrCreateSupportUser) — un User
  // réel de l'organisation ciblée (pour que toute la logique RBAC/écritures
  // existante continue de fonctionner sans modification), mais qui ne peut
  // jamais se connecter normalement et n'apparaît jamais dans l'équipe vue
  // par le client (services/team.service.ts).
  isSupportAccount Boolean @default(false)

  journalEntriesCreated    JournalEntry[]    @relation("JournalEntryCreatedBy")
  journalEntriesValidated  JournalEntry[]    @relation("JournalEntryValidatedBy")
  scannedDocumentsUploaded ScannedDocument[]
  aiConversations          AiConversation[]
  auditLogs                AuditLog[]

  @@index([organizationId])
  @@index([organizationId, role])
}

// ============================================================================
// AUDIT (immuable)
// ============================================================================

// Journal d'audit immuable — aucune mise à jour ni suppression prévue côté
// application; utilisé pour la traçabilité (écritures comptables, actions
// sensibles) et les exigences réglementaires.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  action     String // ex: "JOURNAL_ENTRY_CREATED", "ASSISTANCE_SESSION_STARTED"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, action])
}

// ============================================================================
// COMPTABILITÉ GÉNÉRALE, ANALYTIQUE ET FISCALE (SYSCOHADA révisé)
// ============================================================================
// Plan comptable par organisation, journaux, écritures en partie double
// (équilibre débit=crédit imposé par services/journal-entry.service.ts,
// jamais laissé au client), tiers, centres de coûts (comptabilité
// analytique), immobilisations, et copilote IA (OCR + chat) qui ne fait que
// PROPOSER des écritures — jamais les poser lui-même directement en base,
// pour garder un principe de double contrôle humain.

enum AccountClass {
  CLASSE1_RESSOURCES_DURABLES
  CLASSE2_ACTIF_IMMOBILISE
  CLASSE3_STOCKS
  CLASSE4_TIERS
  CLASSE5_TRESORERIE
  CLASSE6_CHARGES
  CLASSE7_PRODUITS
  CLASSE8_AUTRES_CHARGES_PRODUITS
}

// Plan comptable de l'organisation, numéroté selon le référentiel SYSCOHADA
// révisé (ex: 601000 Achats de marchandises, 411000 Clients, 445200 TVA
// facturée). Propre à chaque tenant pour permettre des comptes auxiliaires
// personnalisés sans affecter les autres organisations.
model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  numero  String // ex: "601100"
  libelle String
  classe  AccountClass

  // Compte collectif nécessitant obligatoirement un tiers sur chaque ligne
  // d'écriture qui l'utilise (comptes 401x fournisseurs, 411x clients).
  isAuxiliaire Boolean @default(false)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalItems        JournalItem[]
  thirdParties        ThirdParty[]
  assetsImmobilisation Asset[] @relation("AssetCompteImmobilisation")
  assetsAmortissement  Asset[] @relation("AssetCompteAmortissement")

  @@unique([organizationId, numero])
  @@index([organizationId])
  @@index([organizationId, classe])
}

enum JournalType {
  ACHATS
  VENTES
  BANQUE
  CAISSE
  OPERATIONS_DIVERSES
  A_NOUVEAUX
}

// Journal comptable (ex: code "AC" Achats, "VE" Ventes, "BQ1" Banque
// principale) — chaque pièce comptable est rattachée à un journal, dont le
// code préfixe la numérotation séquentielle de la pièce.
model Journal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code     String // "AC", "VE", "BQ1", "CA1", "OD"
  libelle  String
  type     JournalType
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries        JournalEntry[]
  bankStatements BankStatement[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

enum JournalEntryStatus {
  BROUILLON
  VALIDEE
}

// Pièce comptable (écriture). Toujours créée avec ses lignes (JournalItem)
// dans la même transaction, après vérification stricte de l'équilibre
// débit=crédit côté service — voir services/journal-entry.service.ts. Une
// fois VALIDEE, une écriture est immuable (aucune route de mise à jour /
// suppression n'est exposée); une correction se fait par contre-passation.
model JournalEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  journalId String
  journal   Journal @relation(fields: [journalId], references: [id])

  numeroPiece  String // séquentiel par journal et par année, ex: "AC-2026-000123"
  dateEcriture DateTime
  libelle      String
  reference    String? // n° facture / bon de commande / pièce source
  status       JournalEntryStatus @default(BROUILLON)

  thirdPartyId String?
  thirdParty   ThirdParty? @relation(fields: [thirdPartyId], references: [id])

  // Document scanné à l'origine de l'écriture, si générée depuis le copilote
  // OCR (voir ScannedDocument) — optionnel, une écriture peut être saisie
  // manuellement sans document source.
  scannedDocumentId String?          @unique
  scannedDocument   ScannedDocument? @relation(fields: [scannedDocumentId], references: [id])

  createdById String
  createdBy   User   @relation("JournalEntryCreatedBy", fields: [createdById], references: [id])

  validatedById String?
  validatedBy   User?     @relation("JournalEntryValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items JournalItem[]

  @@unique([organizationId, journalId, numeroPiece])
  @@index([organizationId])
  @@index([organizationId, dateEcriture])
  @@index([journalId])
}

// Ligne de l'écriture: chaque ligne est renseignée soit au débit soit au
// crédit (jamais les deux), l'égalité de la somme des deux colonnes sur
// l'ensemble des lignes d'une pièce étant la seule condition de validité en
// partie double — imposée par services/journal-entry.service.ts avant tout
// prisma.journalEntry.create. costCenterId est l'axe de ventilation
// analytique optionnel (comptabilité analytique).
model JournalItem {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  thirdPartyId String?
  thirdParty   ThirdParty? @relation(fields: [thirdPartyId], references: [id])

  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  libelle String
  debit   Decimal @default(0) @db.Decimal(14, 2)
  credit  Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  bankStatementLine BankStatementLine?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([costCenterId])
}

// Centre de coût / axe analytique (ex: "Commercial", "Production",
// "Chantier Douala") — permet de ventiler une charge ou un produit
// indépendamment de son compte général, pour la comptabilité analytique.
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code     String
  libelle  String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalItems JournalItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

enum ThirdPartyType {
  CLIENT
  FOURNISSEUR
  AUTRE
}

// Tiers (client ou fournisseur), rattaché à un compte collectif (411xxx ou
// 401xxx) pour la ventilation par tiers du grand livre auxiliaire.
model ThirdParty {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code          String // matricule interne, ex: "CL0001"
  raisonSociale String
  type          ThirdPartyType

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  ninea     String? // identifiant fiscal / contribuable
  telephone String?
  email     String?
  adresse   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalEntries JournalEntry[]
  journalItems   JournalItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, type])
}

enum AssetDepreciationMethod {
  LINEAIRE
  DEGRESSIF
}

enum AssetStatus {
  EN_SERVICE
  CEDE
  REFORME
}

// Immobilisation, avec ses comptes de rattachement (classe 2 pour la valeur
// d'acquisition, compte d'amortissement associé) — le calcul de la dotation
// périodique est effectué côté service, pas stocké en base au-delà du cumul
// courant (cumulAmortissement), pour rester simple à corriger en cas d'erreur.
model Asset {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  libelle              String
  numeroImmobilisation String

  compteImmobilisationId String
  compteImmobilisation   Account @relation("AssetCompteImmobilisation", fields: [compteImmobilisationId], references: [id])

  compteAmortissementId String?
  compteAmortissement   Account? @relation("AssetCompteAmortissement", fields: [compteAmortissementId], references: [id])

  valeurAcquisition      Decimal                 @db.Decimal(14, 2)
  valeurResiduelle       Decimal                 @default(0) @db.Decimal(14, 2)
  dateAcquisition        DateTime
  dureeAmortissementMois Int
  methodeAmortissement   AssetDepreciationMethod @default(LINEAIRE)
  cumulAmortissement     Decimal                 @default(0) @db.Decimal(14, 2)
  status                 AssetStatus             @default(EN_SERVICE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, numeroImmobilisation])
  @@index([organizationId])
}

enum ScannedDocumentStatus {
  EN_ATTENTE
  TRAITE
  ECHEC
  IGNORE
}

// Document scanné (facture, reçu) soumis au copilote OCR. extractedData
// stocke la réponse brute (validée) de l'IA: montants, tiers détecté, lignes
// d'écriture proposées — jamais posées automatiquement, voir JournalEntry.
model ScannedDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  fileUrl  String
  fileName String
  mimeType String

  status               ScannedDocumentStatus @default(EN_ATTENTE)
  extractedData        Json?
  suggestedJournalType JournalType?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  journalEntry JournalEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
}

enum AiMessageRole {
  USER
  ASSISTANT
}

// Fil de discussion avec l'assistant CFO (voir components/ai/CfoAssistantChat.tsx).
model AiConversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  titre String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([organizationId])
  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiMessageRole
  contenu String

  // Métadonnées de la réponse IA (ex: sources citées, latence) — jamais de
  // donnée nécessaire au rendu du fil, purement diagnostique.
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId])
}

enum BankStatementStatus {
  IMPORTE
  RAPPROCHE
}

// Relevé bancaire importé pour rapprochement avec les écritures du journal
// banque correspondant.
model BankStatement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  journalId String
  journal   Journal @relation(fields: [journalId], references: [id])

  libelle      String
  dateDebut    DateTime
  dateFin      DateTime
  soldeInitial Decimal             @db.Decimal(14, 2)
  soldeFinal   Decimal             @db.Decimal(14, 2)
  status       BankStatementStatus @default(IMPORTE)
  fileUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BankStatementLine[]

  @@index([organizationId])
}

// Ligne de relevé, rapprochée à une ligne d'écriture (JournalItem) du
// journal banque une fois pointée — isRapproche reste false tant qu'aucune
// correspondance n'a été établie côté utilisateur.
model BankStatementLine {
  id              String        @id @default(cuid())
  bankStatementId String
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)

  dateOperation DateTime
  libelle       String
  montant       Decimal @db.Decimal(14, 2) // signé: positif = crédit banque, négatif = débit banque
  isRapproche   Boolean @default(false)

  journalItemId String?      @unique
  journalItem   JournalItem? @relation(fields: [journalItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([bankStatementId])
}
