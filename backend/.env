# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database — update with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:password@localhost:5432/finitrans_db?schema=public"

# JWT — change these in production (min 32 chars)
JWT_SECRET=finitrans-jwt-secret-super-secure-2024-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=finitrans-refresh-secret-super-secure-2024-change-me
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:8080

# DI Alert thresholds
DI_ALERT_50=50
DI_ALERT_75=75
DI_ALERT_90=90

# SLA defaults (hours)
SLA_RECEPTION=48
SLA_CODAGE=24
SLA_VALIDATION=24
SLA_PAIEMENT=48
SLA_BON_COMPAGNIE=24
SLA_OPERATIONS_KRIBI=72
SLA_CLOTURE=24

# Logging
LOG_LEVEL=info
