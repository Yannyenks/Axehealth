# Application
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://finitrans:password@localhost:5432/finitrans_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (for Bull queues & caching)
REDIS_URL=redis://localhost:6379

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:8080

# DI Alert thresholds (percentages consumed)
DI_ALERT_50=50
DI_ALERT_75=75
DI_ALERT_90=90
DI_ALERT_100=100

# SLA defaults (hours)
SLA_RECEPTION=48
SLA_CODAGE=24
SLA_VALIDATION=24
SLA_PAIEMENT=48
SLA_BON_COMPAGNIE=24
SLA_OPERATIONS_KRIBI=72
SLA_CLOTURE=24

# Logging
LOG_LEVEL=info
