generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  DIRECTEUR_GENERAL
  RESPONSABLE_EXPLOITATION
  RESPONSABLE_LOGISTIQUE
  RESPONSABLE_VALIDATION
  RESPONSABLE_SORTIES
  SERVICE_ADMINISTRATIF
  COMPTABLE
  RESPONSABLE_DOUANIER
}

enum Site {
  DOUALA
  KRIBI
}

enum Compagnie {
  MSC
  COSCO
  MAERSK
  CMA_CGM
}

enum DossierStatus {
  RECEPTION
  CODAGE
  VALIDATION
  PAIEMENT
  BON_COMPAGNIE
  OPERATIONS_KRIBI
  CLOTURE
}

enum Priorite {
  HAUTE
  MOYENNE
  BASSE
}

enum ContainerSize {
  X20
  X40
  X40HC
  X45
}

enum ContainerStatus {
  EN_ATTENTE
  EN_TRANSIT
  SORTI
  RETOURNE
}

enum DIStatut {
  ACTIVE
  EPUISEE
  EXPIREE
  SUSPENDUE
}

enum DIOperationStatut {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
}

enum DocumentType {
  FACTURE
  CERTIFICAT
  DECLARATION_DOUANE
  BON_LIVRAISON
  DOCUMENT_SGS
  GATE_PASS
  RAPPORT
  PROFORMA
  AUTRE
}

enum StepStatut {
  EN_ATTENTE
  EN_COURS
  TERMINE
  BLOQUE
}

enum AlertType {
  DETENTION
  PAIEMENT
  BLOCAGE
  DOCUMENT
  CHARGE
  DI_SEUIL
  SLA_DEPASSEMENT
  EXPIRATION_DI
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO
}

enum NotificationType {
  ALERTE
  DOSSIER_UPDATE
  MESSAGE
  DI_SEUIL
  SLA_REMINDER
  SYSTEM
}

enum ConversationType {
  DOSSIER
  GENERAL
  URGENCE
}

enum PaymentType {
  DROITS
  TAXES
  REDEVANCES
  PENALITE
}

enum CompanyPaymentType {
  SURESTARIES
  FRAIS_PORTUAIRES
  MANUTENTION
  TERMINAL
}

enum PaymentStatut {
  EN_ATTENTE
  PAYE
  EN_RETARD
  ANNULE
}

enum BonKribiType {
  DOUANE
  COMPAGNIE_PAK
  PORTUAIRE_PAD
}

enum BonStatut {
  EMIS
  VALIDE
  UTILISE
  EXPIRE
}

enum GatePassStatut {
  EMIS
  TRANSMIS
  UTILISE
}

enum DelayMotif {
  COUPURE_INTERNET
  COUPURE_ELECTRICITE
  ATTENTE_CLIENT
  ATTENTE_ADMINISTRATION
  ATTENTE_SGS
  AUTRE
}

// ─────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  nom         String
  prenom      String
  role        Role
  site        Site
  telephone   String?
  avatar      String?
  actif       Boolean   @default(true)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  refreshTokens           RefreshToken[]
  dossiersResponsable     Dossier[]                 @relation("DossierResponsable")
  dossiersCreateur        Dossier[]                 @relation("DossierCreateur")
  documentsUploades       Document[]
  commentaires            Comment[]
  auditLogs               AuditLog[]
  alertesCreees           Alert[]                   @relation("AlertCreateur")
  notifications           Notification[]
  messagesEnvoyes         Message[]
  conversationsMembre     ConversationParticipant[]
  workflowActions         WorkflowAction[]
  delayReports            DelayReport[]
  diOperationsValidees    DIOperation[]             @relation("DIOperationValidateur")
  bonsKribi               BonKribi[]
  gatePasses              GatePass[]
  slaConfigsModifiees     SLAConfig[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// DOSSIERS
// ─────────────────────────────────────────────

model Dossier {
  id                String        @id @default(cuid())
  numero            String        @unique
  client            String
  compagnie         Compagnie
  marchandise       String
  site              Site
  status            DossierStatus @default(RECEPTION)
  priorite          Priorite      @default(MOYENNE)
  dateCreation      DateTime      @default(now())
  dateArrivee       DateTime
  dateLimiteSortie  DateTime?
  notes             String?
  closedAt          DateTime?

  responsableId     String
  responsable       User          @relation("DossierResponsable", fields: [responsableId], references: [id])
  createurId        String
  createur          User          @relation("DossierCreateur", fields: [createurId], references: [id])

  // DI Liaison
  diId              String?
  di                DI?           @relation(fields: [diId], references: [id])
  numeroDI          String?

  // Financial summary (denormalized for performance)
  montantTaxes      Float?
  montantHonoraires Float?
  montantRedevances Float?

  // Relations
  containers         Container[]
  documents          Document[]
  commentaires       Comment[]
  auditLogs          AuditLog[]
  workflowSteps      WorkflowStep[]
  alertes            Alert[]
  diOperations       DIOperation[]
  paiementsDouane    CustomsPayment[]
  paiementsCompagnie CompanyPayment[]
  bonsKribi          BonKribi[]
  gatePasses         GatePass[]
  conversations      Conversation[]

  @@index([status])
  @@index([site])
  @@index([responsableId])
  @@index([diId])
  @@map("dossiers")
}

// ─────────────────────────────────────────────
// CONTAINERS (multiple per dossier)
// ─────────────────────────────────────────────

model Container {
  id         String          @id @default(cuid())
  numero     String
  type       String?
  taille     ContainerSize?
  statut     ContainerStatus @default(EN_ATTENTE)
  notes      String?
  dossierId  String
  dossier    Dossier         @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  gatePasses GatePass[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([dossierId])
  @@map("containers")
}

// ─────────────────────────────────────────────
// DI — DÉCLARATIONS D'IMPORTATION
// ─────────────────────────────────────────────

model DI {
  id               String      @id @default(cuid())
  numero           String      @unique
  client           String
  montantTotal     Float
  montantConsomme  Float       @default(0)
  dateCreation     DateTime    @default(now())
  dateExpiration   DateTime
  statut           DIStatut    @default(ACTIVE)
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  dossiers         Dossier[]
  operations       DIOperation[]
  alertes          Alert[]

  @@index([client])
  @@index([statut])
  @@map("dis")
}

model DIOperation {
  id               String            @id @default(cuid())
  diId             String
  di               DI                @relation(fields: [diId], references: [id])
  dossierId        String
  dossier          Dossier           @relation(fields: [dossierId], references: [id])
  nombreConteneurs Int               @default(1)
  montant          Float
  factureNumero    String?
  factureUrl       String?
  date             DateTime          @default(now())
  commentaire      String?
  statut           DIOperationStatut @default(EN_ATTENTE)
  validateurId     String?
  validateur       User?             @relation("DIOperationValidateur", fields: [validateurId], references: [id])
  validatedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([diId])
  @@index([dossierId])
  @@map("di_operations")
}

// ─────────────────────────────────────────────
// DOCUMENTS
// ─────────────────────────────────────────────

model Document {
  id             String        @id @default(cuid())
  nom            String
  type           DocumentType
  taille         Int
  url            String
  mimetype       String
  description    String?
  dossierId      String
  dossier        Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploadeParId   String
  uploader       User          @relation(fields: [uploadeParId], references: [id])
  etape          DossierStatus?
  workflowStepId String?
  workflowStep   WorkflowStep? @relation(fields: [workflowStepId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([dossierId])
  @@index([workflowStepId])
  @@map("documents")
}

// ─────────────────────────────────────────────
// WORKFLOW STEPS WITH SLA
// ─────────────────────────────────────────────

model WorkflowStep {
  id                 String        @id @default(cuid())
  dossierId          String
  dossier            Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  etape              DossierStatus
  statut             StepStatut    @default(EN_ATTENTE)
  responsableId      String?
  debutAt            DateTime?
  finAt              DateTime?
  slaHeures          Float
  delaiDepasse       Boolean       @default(false)
  retardMinutes      Int?
  motifRetard        DelayMotif?
  explicationRetard  String?
  preuveRequise      Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  actions            WorkflowAction[]
  documents          Document[]

  @@unique([dossierId, etape])
  @@index([dossierId])
  @@map("workflow_steps")
}

model WorkflowAction {
  id             String       @id @default(cuid())
  workflowStepId String
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  action         String
  commentaire    String?
  createdAt      DateTime     @default(now())

  @@index([workflowStepId])
  @@map("workflow_actions")
}

// ─────────────────────────────────────────────
// SLA CONFIGURATION
// ─────────────────────────────────────────────

model SLAConfig {
  id          String        @id @default(cuid())
  etape       DossierStatus @unique
  slaHeures   Float
  labelFr     String
  description String?
  updatedAt   DateTime      @updatedAt
  updatedById String?
  updatedBy   User?         @relation(fields: [updatedById], references: [id])

  @@map("sla_configs")
}

// ─────────────────────────────────────────────
// DELAY REPORTS
// ─────────────────────────────────────────────

model DelayReport {
  id            String        @id @default(cuid())
  dossierId     String
  etape         DossierStatus
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  motif         DelayMotif
  explication   String
  retardMinutes Int
  createdAt     DateTime      @default(now())

  @@index([dossierId])
  @@map("delay_reports")
}

// ─────────────────────────────────────────────
// ALERTS & NOTIFICATIONS
// ─────────────────────────────────────────────

model Alert {
  id         String        @id @default(cuid())
  type       AlertType
  message    String
  severity   AlertSeverity @default(WARNING)
  dossierId  String?
  dossier    Dossier?      @relation(fields: [dossierId], references: [id])
  diId       String?
  di         DI?           @relation(fields: [diId], references: [id])
  creeParId  String?
  createur   User?         @relation("AlertCreateur", fields: [creeParId], references: [id])
  lu         Boolean       @default(false)
  luAt       DateTime?
  resolue    Boolean       @default(false)
  resolueAt  DateTime?
  createdAt  DateTime      @default(now())

  @@index([severity])
  @@index([lu])
  @@index([dossierId])
  @@index([diId])
  @@map("alerts")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  titre     String
  message   String
  data      Json?
  lu        Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, lu])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────────

model Conversation {
  id           String                    @id @default(cuid())
  titre        String
  type         ConversationType          @default(GENERAL)
  dossierId    String?
  dossier      Dossier?                  @relation(fields: [dossierId], references: [id])
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  auteurId       String
  auteur         User         @relation(fields: [auteurId], references: [id])
  contenu        String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("messages")
}

model Comment {
  id        String   @id @default(cuid())
  dossierId String
  dossier   Dossier  @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteurId  String
  auteur    User     @relation(fields: [auteurId], references: [id])
  message   String
  createdAt DateTime @default(now())

  @@index([dossierId])
  @@map("comments")
}

// ─────────────────────────────────────────────
// FINANCIAL
// ─────────────────────────────────────────────

model CustomsPayment {
  id        String        @id @default(cuid())
  dossierId String
  dossier   Dossier       @relation(fields: [dossierId], references: [id])
  type      PaymentType
  montant   Float
  statut    PaymentStatut @default(EN_ATTENTE)
  reference String?
  date      DateTime      @default(now())
  paidAt    DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([dossierId])
  @@map("customs_payments")
}

model CompanyPayment {
  id        String             @id @default(cuid())
  dossierId String
  dossier   Dossier            @relation(fields: [dossierId], references: [id])
  compagnie Compagnie
  type      CompanyPaymentType
  montant   Float
  statut    PaymentStatut      @default(EN_ATTENTE)
  reference String?
  date      DateTime           @default(now())
  paidAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([dossierId])
  @@map("company_payments")
}

model Transfer {
  id               String        @id @default(cuid())
  montant          Float
  description      String
  date             DateTime      @default(now())
  statut           PaymentStatut @default(EN_ATTENTE)
  compteSource     String
  compteDestination String
  reference        String?
  createdAt        DateTime      @default(now())

  @@map("transfers")
}

// ─────────────────────────────────────────────
// KRIBI OPERATIONS
// ─────────────────────────────────────────────

model BonKribi {
  id            String       @id @default(cuid())
  dossierId     String
  dossier       Dossier      @relation(fields: [dossierId], references: [id])
  type          BonKribiType
  numero        String
  statut        BonStatut    @default(EMIS)
  responsableId String
  responsable   User         @relation(fields: [responsableId], references: [id])
  factureUrl    String?
  montant       Float?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([dossierId])
  @@map("bons_kribi")
}

model GatePass {
  id           String         @id @default(cuid())
  dossierId    String
  dossier      Dossier        @relation(fields: [dossierId], references: [id])
  containerId  String?
  container    Container?     @relation(fields: [containerId], references: [id])
  numero       String         @unique
  chauffeur    String
  telephone    String
  destination  String
  statut       GatePassStatut @default(EMIS)
  dateEmission DateTime       @default(now())
  emetteurId   String
  emetteur     User           @relation(fields: [emetteurId], references: [id])
  transmisAt   DateTime?
  utiliseAt    DateTime?

  @@index([dossierId])
  @@map("gate_passes")
}

// ─────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  dossierId String?
  dossier   Dossier? @relation(fields: [dossierId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entite    String?
  entiteId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([dossierId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
