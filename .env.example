DATABASE_URL="postgresql://user:password@localhost:5432/axehealth?schema=public"

JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"

# Mobile Money / Carte — endpoints par défaut = sandbox indicatifs, à
# remplacer par ceux du contrat marchand réel (voir lib/integrations/mobile-money.ts)
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=
WAVE_API_KEY=
WAVE_BASE_URL=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Gateway SMS générique (Africa's Talking, Twilio, etc.)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BASE_URL=

# Secret partagé pour authentifier les webhooks entrants (Mobile Money) —
# à remplacer par la vérification de signature propre au fournisseur en prod.
MOBILE_MONEY_WEBHOOK_SECRET=
