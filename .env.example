DATABASE_URL="postgresql://user:password@localhost:5432/axehealth?schema=public"

# Base dédiée aux tests d'intégration (npm test) — jamais la base de
# développement/démo, pour ne jamais perdre de données réelles à l'exécution.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/axehealth_test?schema=public"

JWT_SECRET="change-me-in-production"
JWT_REFRESH_SECRET="change-me-too-in-production"

# Chiffrement au repos des antécédents médicaux (voir lib/encryption.ts).
# 32 octets encodés en base64 — générer avec: openssl rand -base64 32
# La perte de cette clé rend les antécédents déjà chiffrés irrécupérables.
ENCRYPTION_KEY=

# Mobile Money / Carte — endpoints par défaut = sandbox indicatifs, à
# remplacer par ceux du contrat marchand réel (voir lib/integrations/mobile-money.ts)
MTN_MOMO_API_KEY=
MTN_MOMO_BASE_URL=
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_BASE_URL=
WAVE_API_KEY=
WAVE_BASE_URL=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Gateway SMS générique (Africa's Talking, Twilio, etc.)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_BASE_URL=

# Secret partagé pour authentifier les webhooks entrants (Mobile Money) —
# à remplacer par la vérification de signature propre au fournisseur en prod.
MOBILE_MONEY_WEBHOOK_SECRET=

# Secret du cron Vercel qui évalue les alertes (voir vercel.json). Vercel
# l'envoie automatiquement en "Authorization: Bearer $CRON_SECRET". Réglé sur
# une fois par jour (7h) — le plan Hobby ne permet qu'un cron quotidien;
# repasser à une fréquence plus fine (ex: */15 * * * *) nécessite un plan Pro.
CRON_SECRET=
